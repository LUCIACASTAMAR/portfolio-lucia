# Supabase > Project Settings > API
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Resend > API Keys and a verified sending domain
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=Portfolio <solicitudes@your-verified-domain.com>
NOTIFICATION_EMAIL=lucycastamar@gmail.com

# Admin panel: use long random values (never commit real secrets)
ADMIN_PASSWORD=replace_with_a_long_unique_password
SESSION_SECRET=replace_with_at_least_32_random_characters
